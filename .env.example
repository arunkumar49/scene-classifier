# Copy to .env.sagemaker (gitignored) and fill in the values. Load it only when you mean to
# log to SageMaker; local runs without it log to ./mlflow.db:
#   uv run --env-file .env.sagemaker python scripts/train.py tracking=sagemaker
#   uv run --env-file .env.sagemaker --group launch python scripts/launch_job.py

# ARN of the SageMaker MLflow App (Studio > MLflow, or `aws sagemaker list-mlflow-apps`)
MLFLOW_TRACKING_URI=arn:aws:sagemaker:<region>:<account-id>:mlflow-app/<app-id>
# AWS profile whose credentials sign the MLflow calls
AWS_PROFILE=<profile>
# IAM role the Training Job runs as (scripts/launch_job.py)
SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/<role-name>

# GIT_COMMIT_SHA is left out on purpose: set it per run from `git rev-parse HEAD`
